LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Envía "strict": true en los schemas de las herramientas. Mejora la adherencia
# al schema, pero no todos los proveedores compatibles con OpenAI lo soportan.
# Ponlo en false si el proveedor rechaza la petición por este campo.
LLM_STRICT_TOOLS=true
